@params(array<App\Todo> $todos, string $title, float $progress, callable():void $onAdd, callable(bool):void $onToggle)

<window title="{{ $title }}" width="460" height="560" id="task-window" class="task-window" tooltip="Démo templates enrichis">
    <style>
        .task-window { background: #101418; color: #e6edf3; }
        .task-panel { padding: 16px; }
        .title { font-size: 22px; font-weight: bold; }
        .hint { color: #8b949e; font-size: 12px; }
        .status { color: #3ddc97; }
        .primary { background: #238636; color: white; }
    </style>

    <box vertical="true" spacing="10" id="todo-list" class="task-panel">
        <label text="{{ $title }}" class="title" />
        <progress-bar fraction="{{ $progress }}" class="progress" />
        <label class="hint">Progression globale</label>
        <separator />

        @if (count($todos) === 0)
            <label class="empty">Aucune tâche pour le moment.</label>
        @endif

        <scrolled height="260" spacing="6">
            @foreach ($todos as $todo)
                <include file="partials/todo-row.ui" todo="{{ $todo }}" toggle="{{ $onToggle }}" />
            @endforeach
        </scrolled>

        <entry placeholder="Nouvelle tâche" class="new-task" />
        <button text="Ajouter" on-click="{{ $onAdd }}" class="primary" />
    </box>
</window>
