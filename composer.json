{
    "name": "cyonima/php-ide",
    "description": "IDE PHP 8 et runtime d'applications desktop natives GTK4",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-ffi": "*"
    },
    "autoload": {
        "psr-4": {
            "Cyonima\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cyonima\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "generate": "php -d ffi.enable=true bin/cyonima-gen generate",
        "demo": "php -d ffi.enable=true examples/counter.php",
        "test": "php -d ffi.enable=true tests/run.php",
        "demo:async": "php -d ffi.enable=true examples/async.php",
        "demo:adw": "php -d ffi.enable=true examples/adw.php",
        "demo:ide": "php -d ffi.enable=true examples/ide.php"
    },
    "config": {
        "sort-packages": true
    }
}
